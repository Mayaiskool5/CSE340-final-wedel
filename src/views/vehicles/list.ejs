<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/main.css">
<main>
    <h1>Vehicles</h1>

    <section class="search-section mb-4">
        <form action="/browse" method="GET" class="search-form">
            <input type="text" name="q" placeholder="Search by make, model, or year..." 
                value="<%= searchTerm %>" class="search-input">
            <button type="submit" class="btn-search">Search</button>
            <% if (searchTerm) { %>
                <a href="/browse" class="btn-clear">Clear</a>
            <% } %>
        </form>
    </section>

    <div class="vehicle-grid">
        <% vehicles.forEach(vehicle => { %>
            <div class="vehicle-card">
                <img 
                    src="<%= vehicle.image_url || '/images/no-image.jpg' %>" 
                    alt="Photo of <%= vehicle.make %> <%= vehicle.model %>" 
                    class="vehicle-photo"
                >
                <h3><a href="/vehicle/<%= vehicle.slug %>"><%= vehicle.make %> <%= vehicle.model %></a></h3>
                <p><strong>Year:</strong> <%= vehicle.year %></p>
                <p><strong>Price:</strong> <%= vehicle.price ? ('$' + vehicle.price) : 'Contact for price' %></p>
                <% const safeUser = typeof user !== 'undefined' ? user : null; %>
                <% if (safeUser && (safeUser.roleName === 'owner' || safeUser.roleName === 'employee')) { %>
                    <a href="/admin/inventory/edit/<%= vehicle.id %>" class="btn-action">Edit</a>
                <% } %>
                <% if (safeUser && safeUser.roleName === 'owner') { %>
                    <form action="/admin/inventory/delete/<%= vehicle.id %>" method="POST">
                        <button type="submit" class="btn-delete" onclick="return confirm('Delete this vehicle?')">Delete</button>
                    </form>
                <% } %>
            </div>
        <% }) %>
    </div>
</main>
<%- include('../partials/footer') %>