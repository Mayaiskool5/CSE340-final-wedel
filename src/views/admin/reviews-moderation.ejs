<%- include('../partials/header') %>
<main class="admin-inventory-container">
    <div class="card inventory-list-card">
        <h1 class="inventory-list-title card-title-center">Review Moderation</h1>
        <table class="service-table inventory-list-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Vehicle</th>
                    <th>Rating</th>
                    <th>Comment</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% reviews.forEach(review => { %>
                    <tr>
                        <td><%= review.user_name %></td>
                        <td><%= review.make %> <%= review.model %></td>
                        <td>
                            <span class="review-rating">
                                <%= review.rating %> <span class="star">&#9733;</span>
                            </span>
                        </td>
                        <td><span class="review-comment"><%= review.comment %></span></td>
                        <td>
                            <form action="/admin/reviews/delete/<%= review.id %>" method="POST" class="inline-form">
                                <input type="hidden" name="vehicle_slug" value="admin/reviews">
                                <button type="submit" class="btn-action" title="Remove review" onclick="return confirm('Delete this review?')">
                                    Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        <a href="/dashboard" class="btn-cancel btn-dashboard-spacing">Back to Dashboard</a>
    </div>
</main>
<%- include('../partials/footer') %>
