<%- include('../partials/header') %>
<main class="admin-inventory-container">
    <div class="card inventory-list-card">
        <h1 class="inventory-list-title">Edit Vehicles</h1>
        <table class="service-table inventory-list-table">
            <thead>
                <tr>
                    <th>Make</th>
                    <th>Model</th>
                    <th>Year</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% vehicles.forEach(vehicle => { %>
                    <tr>
                        <td><%= vehicle.make %></td>
                        <td><%= vehicle.model %></td>
                        <td><%= vehicle.year %></td>
                        <td><%= vehicle.category_name %></td>
                        <td>
                            <a href="/admin/inventory/edit/<%= vehicle.id %>" class="btn-action">Edit</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        <a href="/dashboard" class="btn-cancel" style="margin-top:1.5rem;">Back to Dashboard</a>
    </div>
</main>
<%- include('../partials/footer') %>
