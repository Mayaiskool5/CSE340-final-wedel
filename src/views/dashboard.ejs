<%- include('partials/header') %>
<main>
    <div class="dashboard-container">
        <!-- Account Column -->
        <section class="account-sidebar">
            <div class="card p-3">
                <h2>Account Details</h2>
                <p><strong>Name:</strong> <%= user.name %></p>
                <p><strong>Email:</strong> <%= user.email %></p>
                <p><strong>Role:</strong> <%= user.role_name %></p>
                <a href="/register/<%= user.id %>/edit" class="logout-button">Edit</a>
                <a href="/logout" class="logout-button">Logout</a>
            </div>
        </section>

        <!-- Service History Column -->
        <section class="history-main">
            <% if (user.role_name === 'customer') { %>
                <div class="card">
                    <div class="card-header dashboard-header-flex">
                        <h3>My Service History</h3>
                        <a href="/service/service" class="btn-action">Book Service</a>
                    </div>
                    
                    <% if (typeof serviceHistory !== 'undefined' && serviceHistory.length > 0) { %>
                        <table class="service-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Vehicle</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% serviceHistory.forEach(request => { %>
                                    <tr>
                                        <td><%= new Date(request.created_at).toLocaleDateString() %></td>
                                        <td><%= request.vehicle_info %></td>
                                        <td>
                                            <span class="status-badge status-<%= request.status.toLowerCase().replace(' ', '-') %>">
                                                <%= request.status %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p class="p-3">No service records found.</p>
                    <% } %>
                </div>
            <% } %>
        </section>

        <!-- User Reviews Section for Customers -->
        <% if (user.role_name === 'customer') { %>
        <div class="card mt-4">
            <div class="card-header">
                <h3>My Reviews</h3>
            </div>
            <% if (reviews && reviews.length > 0) { %>
                <table class="service-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Vehicle</th>
                            <th>Rating</th>
                            <th>Review</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% reviews.forEach(review => { %>
                        <tr>
                            <td><%= new Date(review.created_at).toLocaleDateString() %></td>
                            <td><a href="/vehicle/<%= review.vehicle_slug %>"><%= review.make %> <%= review.model %> (<%= review.year %>)</a></td>
                            <td><%= review.rating %> / 5</td>
                            <td><%= review.comment %></td>
                            <td>
                                <form action="/reviews/delete/<%= review.id %>" method="POST" style="display:inline;">
                                    <input type="hidden" name="vehicle_slug" value="<%= review.vehicle_slug %>">
                                    <button type="submit" class="btn-delete" onclick="return confirm('Delete this review?')">Delete</button>
                                </form>
                                <a href="/reviews/edit/<%= review.id %>?vehicle_slug=<%= review.vehicle_slug %>" class="btn-action edit-btn">Edit</a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p class="p-3">You have not submitted any reviews yet.</p>
            <% } %>
        </div>
        <% } %>

        <!-- Staff/Owner Reviews Section -->
        <% if (user.role_name === 'employee' || user.role_name === 'owner') { %>
        <div class="card mt-4">
            <div class="card-header">
                <h3>All Reviews</h3>
            </div>
            <% if (reviews && reviews.length > 0) { %>
                <table class="service-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Vehicle</th>
                            <th>Rating</th>
                            <th>Review</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% reviews.forEach(review => { %>
                        <tr>
                            <td><%= new Date(review.created_at).toLocaleDateString() %></td>
                            <td><%= review.user_name %></td>
                            <td><a href="/vehicle/<%= review.vehicle_slug %>"><%= review.make %> <%= review.model %> (<%= review.year %>)</a></td>
                            <td><%= review.rating %> / 5</td>
                            <td><%= review.comment %></td>
                            <td>
                                <form action="/reviews/delete/<%= review.id %>" method="POST" style="display:inline;">
                                    <input type="hidden" name="vehicle_slug" value="<%= review.vehicle_slug %>">
                                    <button type="submit" class="btn-delete" onclick="return confirm('Delete this review?')">Delete</button>
                                </form>
                                <!-- Optionally add edit button here -->
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p class="p-3">No reviews found.</p>
            <% } %>
        </div>
        <% } %>

        <!-- EMPLOYEE & OWNER SHARED TOOLS -->
        <% if (user.role_name === 'employee' || user.role_name === 'owner') { %>
            <section class="admin-panel">
                <h2>Staff Management Tools</h2>
                <ul>
                    <li><a href="/services/manage">Manage Service Requests (Update Status/Notes)</a></li>
                    <li><a href="/admin/reviews">Moderate/Delete Reviews</a></li>
                    <li><a href="/contact/responses">View Contact Form Submissions</a></li>
                </ul>
            </section>
        <% } %>

        <!-- OWNER ONLY TOOLS -->
        <% if (user.role_name === 'owner') { %>
            <section class="owner-panel">
                <h2>Owner Controls (Full Admin)</h2>
                <ul>
                    <li><a href="/admin/inventory/list">Edit Vehicles</a></li>
                    <li><a href="/admin/inventory/add">Add Vehicle</a></li>
                    <li><a href="/admin/categories">Manage Vehicle Categories</a></li>
                    <li><a href="/register/list">View All System Activity & Users</a></li>
                </ul>
            </section>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>
