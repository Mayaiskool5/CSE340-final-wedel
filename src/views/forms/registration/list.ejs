<%- include('../../partials/header') %>
<main>
    <div class="registration-list-container" style="max-width: 900px; margin: 2.5rem auto 2rem auto;">
        <h1 class="register-list-title" style="text-align:center; font-size:2rem; font-weight:800; color:#2563eb; margin-bottom:2.2rem;"> <%= title %> </h1>
        <% if (users && users.length > 0) { %>
            <div class="users-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2rem;">
                <% users.forEach(listUser => { %>
                    <% 
                        const currentUser = locals.user || null;
                        const canEdit = currentUser && (currentUser.roleName === 'admin' || currentUser.roleName === 'owner');
                        const canDelete = currentUser && currentUser.roleName === 'admin' && currentUser.id !== listUser.id;
                    %>
                    <div class="user-card" style="background:#fff; border-radius:16px; box-shadow:0 4px 16px rgba(0,0,0,0.10); padding:2rem 1.5rem 1.5rem 1.5rem; display:flex; flex-direction:column; align-items:center;">
                        <h3 style="font-size:1.25rem; font-weight:700; color:#1741a6; margin-bottom:0.5rem;"> <%= listUser.name %> </h3>
                        <p style="font-size:1.01rem; color:#444; margin-bottom:1.2rem;"> <%= listUser.email %> </p>
                        <% if (canEdit || canDelete) { %>
                            <div class="user-actions" style="display:flex; gap:0.7rem;">
                                <% if (canEdit) { %>
                                    <a href="/register/<%= listUser.id %>/edit" class="btn-primary" style="padding:0.6rem 1.2rem; font-size:0.98rem; border-radius:6px; background:#2563eb; color:#fff; font-weight:600; text-decoration:none; transition:background 0.2s;">Edit</a>
                                <% } %>
                                <% if (canDelete) { %>
                                    <form method="POST" action="/register/<%= listUser.id %>/delete" style="display:inline;">
                                        <button type="submit" class="btn-delete" style="padding:0.6rem 1.2rem; font-size:0.98rem; border-radius:6px; background:#dc3545; color:#fff; font-weight:600; border:none; cursor:pointer; transition:background 0.2s;" onclick="return confirm('Are you sure you want to delete this user?')">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p class="no-users" style="text-align:center; color:#888; font-size:1.1rem; margin-top:2.5rem;">No users registered yet.</p>
        <% } %>
    </div>
</main>
<%- include('../../partials/footer') %>