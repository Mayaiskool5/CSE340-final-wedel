<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/vehicle-catalog.css">
<link rel="stylesheet" href="/css/main.css">
<main>
    <h1>Vehicle Catalog</h1>
    <p>Browse our available vehicles and click on any vehicle to see detailed information.</p>

    <div class="vehicle-list">
        <% if (vehicles.length === 0) { %>
            <p>No vehicles found in the catalog.</p>
        <% } else { %>
            <% vehicles.forEach(vehicle => { %>
                <div class="vehicle-card">
                    <img src="<%= vehicle.main_image || '/images/no-image.jpg' %>" alt="<%= vehicle.make %> <%= vehicle.model %>" class="vehicle-image">
                    <h3><a href="/vehicle/<%= vehicle.slug %>" class="btn"><%= vehicle.make %> <%= vehicle.model %></a></h3>
                    <p class="vehicle-id">ID: <%= vehicle.id %></p>
                    <p class="vehicle-category"><strong>Category:</strong> <%= vehicle.category_name || 'N/A' %></p>
                    <p class="vehicle-description"><%= vehicle.price ? ('$' + vehicle.price) : '' %></p>
                </div>
            <% }); %>
        <% } %>
    </div>

    <!-- Reviews are not shown on the catalog list page -->
</main>
<%- include('../partials/footer') %>