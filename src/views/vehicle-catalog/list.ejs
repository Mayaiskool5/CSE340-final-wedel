<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/vehicle-catalog.css">
<link rel="stylesheet" href="/css/main.css">
<main>
    <h1>Vehicle Catalog</h1>
    <section class="search-section mb-4">
        <form action="/catalog" method="GET" class="search-form">
            <input type="text" name="q" placeholder="Search by make, model, or year..." 
                value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>" class="search-input">
            <button type="submit" class="btn-search">Search</button>
            <% if (typeof searchTerm !== 'undefined' && searchTerm) { %>
                <a href="/catalog" class="btn-clear">Clear</a>
            <% } %>
        </form>
    </section>

    <div class="vehicle-list">
        <% if (vehicles.length === 0) { %>
            <p>No vehicles found in the catalog.</p>
        <% } else { %>
            <% vehicles.forEach(vehicle => { %>
                <div class="vehicle-card">
                    <img src="<% let img = vehicle.main_image || vehicle.image_url; %><%= img ? (img.startsWith('/') ? img : '/images/vehicles/' + img) : '/images/no-image.jpg' %>" alt="<%= vehicle.make %> <%= vehicle.model %>" class="vehicle-image">
                    <h3><a href="/vehicle/<%= vehicle.slug %>" class="btn"><%= vehicle.make %> <%= vehicle.model %></a></h3>
                    <p class="vehicle-id">ID: <%= vehicle.id %></p>
                    <p class="vehicle-category"><strong>Category:</strong> <%= vehicle.category_name || 'N/A' %></p>
                    <p class="vehicle-description"><%= vehicle.price ? ('$' + Math.round(Number(vehicle.price)).toLocaleString()) : '' %></p>
                    <% const safeUser = typeof user !== 'undefined' ? user : null; %>
                    <% if (safeUser && (safeUser.roleName === 'owner' || safeUser.roleName === 'employee')) { %>
                        <a href="/admin/inventory/edit/<%= vehicle.id %>" class="btn-action">Edit</a>
                    <% } %>
                    <% if (safeUser && safeUser.roleName === 'owner') { %>
                        <form action="/admin/inventory/delete/<%= vehicle.id %>" method="POST">
                            <button type="submit" class="btn-delete" onclick="return confirm('Delete this vehicle?')">Delete</button>
                        </form>
                    <% } %>
                </div>
            <% }); %>
        <% } %>
    </div>
</main>
<%- include('../partials/footer') %>