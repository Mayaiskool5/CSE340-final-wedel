<!DOCTYPE html>
<html lang="en">
<div class="site-greeting">
    <%- locals.greeting %>
</div>
<head>
<%- locals.renderStyles() %>
<%- locals.renderScripts() %>
<link rel="stylesheet" href="/css/main.css">
</head>
<body class="<%= bodyClass %>">
    <header style="text-align: center;">
        <nav>
            <ul style="display: inline-block; padding: 0; margin: 0;">
                <!-- Always visible links -->
                <li style="display: inline;"><a href="/">Home</a></li>
                <span>|</span>
                <li style="display: inline;"><a href="/catalog">Vehicle Catalog</a></li>
                <span>|</span>
                <!-- Browse by Category removed for catalog unification -->
                <li style="display: inline;"><a href="/contact">Contact</a></li>

                <!-- Only visible when logged in -->
                <% const safeUser = typeof user !== 'undefined' ? user : null; %>
                <% if (isLoggedIn) { %>
                    <span>|</span>
                    <li style="display: inline;"><a href="/dashboard">Dashboard</a></li>
                    <% if (safeUser && (safeUser.roleName === 'customer' || safeUser.role_name === 'customer')) { %>
                        <span>|</span>
                        <li style="display: inline;"><a href="/service/service">Request Service</a></li>
                    <% } %>
                    <% if (safeUser && ((safeUser.roleName === 'employee' || safeUser.roleName === 'owner') || (safeUser.role_name === 'employee' || safeUser.role_name === 'owner'))) { %>
                        <span>|</span>
                        <li style="display: inline;"><a href="/contact/responses">Contact Responses</a></li>
                    <% } %>
                    <% if (safeUser && safeUser.roleName === 'owner') { %>
                        <span>|</span>
                        <li style="display: inline;"><a href="/admin/logs">Activity Logs</a></li>
                        <span>|</span>
                        <li style="display: inline;"><a href="/admin/users">All Users</a></li>
                    <% } %>
                    <span>|</span>
                    <li style="display: inline;"><a href="/logout">Logout</a></li>
                <% } %>

                <!-- Only visible when NOT logged in -->
                <% if (!isLoggedIn) { %>
                    <span>|</span>
                    <li style="display: inline;"><a href="/login">Login</a></li>
                    <span>|</span>
                    <li style="display: inline;"><a href="/register">Register</a></li>
                <% } %>
            </ul>
        </nav>
    </header>
    <% 
        const messages = flash();
        const hasMessages = Object.values(messages).some(arr => arr.length > 0);
    %>

    <% if (hasMessages) { %>
        <div class="flash-messages">
            <% Object.keys(messages).forEach(type => { %>
                <% messages[type].forEach(message => { %>
                    <div class="flash <%= type %>">
                        <%= message %>
                    </div>
                <% }); %>
            <% }); %>
        </div>
    <% } %>
</body>